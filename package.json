{
  "name": "apiforge-lite",
  "version": "0.1.0",
  "description": "ApiForge Lite - Spring Edition: Lightweight desktop API client for Spring Boot developers",
  "main": "src/main/main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "test": "node --test tests/foundation.test.js tests/http.test.js tests/collections.test.js tests/history_settings.test.js tests/automated_testing.test.js tests/openapi_import.test.js tests/error_explainer.test.js tests/role_matrix.test.js",
    "test:smoke": "electron tests/smoke.js",
    "build": "electron-builder --win",
    "dist": "electron-builder --win"
  },
  "keywords": [
    "electron",
    "api-client",
    "spring-boot",
    "rest",
    "developer-tools"
  ],
  "author": "ApiForge Team",
  "license": "MIT",
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.apiforge.lite",
    "productName": "ApiForge Lite",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ApiForge Lite",
      "uninstallDisplayName": "ApiForge Lite"
    }
  }
}
